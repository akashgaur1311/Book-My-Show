pipeline {
    agent any

    tools {
        jdk 'jdk21'
        nodejs 'node26'
    }

    environment {
        SCANNER_HOME      = tool 'sonar-scanner'
        DOCKER_IMAGE      = 'akashgaur1311/bms:latest'
        EKS_CLUSTER_NAME  = 'bms-eks'
        AWS_REGION        = 'ap-south-1'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git(
                    branch: 'main',
                    url: 'https://github.com/KastroVKiran/Book-My-Show.git'
                )

                sh '''
                    echo "Repository files:"
                    ls -la
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '''
                        $SCANNER_HOME/bin/sonar-scanner \
                            -Dsonar.projectName=BMS \
                            -Dsonar.projectKey=BMS
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    waitForQualityGate(
                        abortPipeline: false,
                        credentialsId: 'Sonar-token'
                    )
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    cd bookmyshow-app

                    echo "Checking application files..."
                    ls -la

                    if [ -f package.json ] && [ -f package-lock.json ]; then
                        echo "Installing dependencies using npm ci..."
                        npm ci
                    else
                        echo "ERROR: package.json or package-lock.json not found!"
                        exit 1
                    fi
                '''
            }
        }

        stage('OWASP FS Scan') {
            steps {
                dependencyCheck(
                    additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit',
                    odcInstallation: 'DP-Check',
                    nvdCredentialsId: 'nvd-api-key'
                )

                dependencyCheckPublisher(
                    pattern: '**/dependency-check-report.xml'
                )
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh '''
                    echo "Running Trivy filesystem scan..."

                    trivy fs . > trivyfs.txt

                    echo "Trivy scan completed."
                '''
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    withDockerRegistry(
                        credentialsId: 'docker',
                        toolName: 'docker'
                    ) {
                        sh '''
                            echo "Building Docker image..."

                            docker build --no-cache \
                                -t $DOCKER_IMAGE \
                                -f bookmyshow-app/Dockerfile \
                                bookmyshow-app

                            echo "Docker image built successfully."

                            echo "Pushing Docker image to Docker Hub..."

                            docker push $DOCKER_IMAGE

                            echo "Docker image pushed successfully."
                        '''
                    }
                }
            }
        }

        stage('Verify AWS Access') {
            steps {
                sh '''
                    echo "Verifying AWS credentials..."

                    aws sts get-caller-identity
                '''
            }
        }

        stage('Configure EKS Access') {
            steps {
                sh '''
                    echo "Configuring kubectl for EKS cluster..."

                    aws eks update-kubeconfig \
                        --name "$EKS_CLUSTER_NAME" \
                        --region "$AWS_REGION"

                    echo "Checking Kubernetes cluster..."

                    kubectl cluster-info

                    echo "Current Kubernetes context:"

                    kubectl config current-context
                '''
            }
        }

        stage('Deploy to EKS Cluster') {
            steps {
                sh '''
                    echo "Deploying application..."

                    kubectl apply -f deployment.yml
                    kubectl apply -f service.yml

                    echo "Kubernetes resources created/updated."
                '''
            }
        }

        stage('Verify EKS Deployment') {
            steps {
                sh '''
                    echo "Checking deployment..."

                    kubectl get deployment

                    echo "Checking pods..."

                    kubectl get pods -o wide

                    echo "Checking services..."

                    kubectl get svc

                    echo "Waiting for deployment rollout..."

                    kubectl rollout status deployment/bms --timeout=180s

                    echo "Deployment completed successfully."

                    echo "Final pod status:"

                    kubectl get pods -o wide
                '''
            }
        }
    }

    post {
        always {
            emailext(
                attachLog: true,
                subject: "${currentBuild.result}",
                body: """
                    Project: ${env.JOB_NAME}<br/>
                    Build Number: ${env.BUILD_NUMBER}<br/>
                    Build Status: ${currentBuild.result}<br/>
                    URL: ${env.BUILD_URL}<br/>
                """,
                to: 'akash.rock1311@gmail.com',
                attachmentsPattern: 'trivyfs.txt'
            )
        }
    }
}
